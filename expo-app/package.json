{
  "name": "expo-app",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~57.0.16",
    "expo-brownfield": "~57.0.14",
    "expo-build-properties": "~57.0.14",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "postinstall": "patch-package",
    "typecheck": "tsc --noEmit",
    "prebuild": "expo prebuild --clean",
    "prebuild:ios": "expo prebuild --platform ios --clean",
    "prebuild:android": "expo prebuild --platform android",
    "brownfield:ios": "expo-brownfield build:ios --release --package RepoSearchKitPackage",
    "brownfield:ios:debug": "expo-brownfield build:ios --debug --package RepoSearchKitPackage",
    "brownfield:ios:xcframeworks": "expo-brownfield build:ios --release",
    "brownfield:android": "expo-brownfield build:android --release"
  },
  "private": true
}
